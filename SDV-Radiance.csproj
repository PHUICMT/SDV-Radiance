<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SDV-Radiance</AssemblyName>
    <RootNamespace>SDVRadiance</RootNamespace>
    <Version>1.2.2</Version>

    <!-- SMAPI mod packaging: auto-detects the game folder and deploys to Mods/.
         Enables the bundled Harmony reference for the deeper _draw hook path. -->
    <EnableHarmony>true</EnableHarmony>
    <EnableModDeploy>true</EnableModDeploy>
    <EnableModZip>true</EnableModZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.3.2" />
  </ItemGroup>

  <!-- The local dev harness (git-excluded, present only on the author's machine) never
       ships in Release builds. Removing a file that doesn't exist is a no-op, so this is
       safe on machines that don't have it. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="src\DevMenu.local.cs" />
  </ItemGroup>

  <!-- Ship compiled shaders (.mgfxo) with the mod. -->
  <ItemGroup>
    <None Include="assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Ship the license and credits with the mod (the Nexus page points to them). -->
  <ItemGroup>
    <None Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="CREDITS.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- If the game folder is not auto-detected, uncomment and set your path:
  <PropertyGroup>
    <GamePath>C:\Program Files (x86)\Steam\steamapps\common\Stardew Valley</GamePath>
  </PropertyGroup>
  -->

</Project>
