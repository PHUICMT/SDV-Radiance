<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>CS0649</NoWarn>
    <AssemblyName>LabelPackHarness</AssemblyName>
    <RootNamespace>LabelPackHarness</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- net9 rather than the mod's net6, because this only has to run on the machine building it and
         no net6 runtime is installed. Referencing net6 assemblies from it is fine. -->
    <ModPath>$(MSBuildThisFileDirectory)..\..</ModPath>
    <!-- Overridable, so this is not tied to one install: dotnet run -p:GamePath=... -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Stardew Valley</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The real source files, compiled into this assembly so that internal types are reachable
         without adding an InternalsVisibleTo to the mod for the sake of a test. -->
    <Compile Include="$(ModPath)\src\LabelPacks.cs" />
    <Compile Include="$(ModPath)\src\LabelStore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="StardewModdingAPI">
      <HintPath>$(GamePath)\StardewModdingAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Stardew Valley">
      <HintPath>$(GamePath)\Stardew Valley.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="xTile">
      <HintPath>$(GamePath)\xTile.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(GamePath)\MonoGame.Framework.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="StardewValley.GameData">
      <HintPath>$(GamePath)\StardewValley.GameData.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
